{
  "appId": "ua.strictai.mobile",
  "appName": "StrictAI",
  "webDir": ".",
  "bundledWebRuntime": false,
  "server": {
    "androidScheme": "https",
    "iosScheme": "capacitor"
  },
  "ios": {
    "contentInset": "automatic",
    "preferredContentMode": "mobile",
    "backgroundColor": "#F6F6F7"
  },
  "android": {
    "allowMixedContent": false,
    "backgroundColor": "#F6F6F7",
    "captureInput": true
  },
  "plugins": {
    "SplashScreen": {
      "launchAutoHide": true,
      "backgroundColor": "#09090B",
      "showSpinner": false
    },
    "StatusBar": {
      "style": "DARK",
      "backgroundColor": "#F6F6F7"
    }
  }
}
