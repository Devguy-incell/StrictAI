{
  "name": "strictai-mobile-app",
  "version": "2.0.0",
  "private": true,
  "description": "StrictAI Mobile Application — Swiss Industrial NMT & Language Mastery Shell (Capacitor + Offline PWA)",
  "scripts": {
    "dev": "npx serve -l 4173 .",
    "check:syntax": "node -e \"const fs=require('fs'),cp=require('child_process');for(const f of fs.readdirSync('./js')){if(f.endsWith('.js'))cp.execFileSync('node',['-c','./js/'+f],{stdio:'inherit'})}\"",
    "check:emoji": "node -e \"const fs=require('fs'),path=require('path');const re=/[\\p{Emoji_Presentation}\\p{Extended_Pictographic}]/u;function walk(d){for(const e of fs.readdirSync(d,{withFileTypes:true})){const p=path.join(d,e.name);if(e.isDirectory()&&!['node_modules','.git','assets'].includes(e.name))walk(p);else if(/\\.(html|css|js|json|webmanifest)$/.test(e.name)){const t=fs.readFileSync(p,'utf8');if(re.test(t)){console.error('Emoji found:',p);process.exit(1);}}}}walk('.');console.log('ZERO_EMOJI_PASS');\"",
    "cap:sync": "npx cap sync"
  },
  "dependencies": {
    "@capacitor/core": "^6.1.0"
  },
  "devDependencies": {
    "@capacitor/cli": "^6.1.0",
    "@capacitor/ios": "^6.1.0",
    "@capacitor/android": "^6.1.0"
  }
}
